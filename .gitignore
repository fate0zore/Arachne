# ROS/colcon generated files
build/
!scripts/build/
!scripts/build/**
install/
log/
logs/
runtime_logs/
.colcon/
.ros/
.vscode/
.DS_Store

# Godot editor/import cache and generated asset links.
godot/**/.godot/
godot/**/.import/
godot/**/assets/generated/
godot/**/assets/vendor/*
!godot/**/assets/vendor/README.md
!godot/**/assets/vendor/.gdignore
# Python generated files
**/__pycache__/
*.py[cod]
*.pyo
*.log
*.tmp
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local secrets and agent provider credentials.
.env
.env.local
.env.*
*.env
!.env.local.example
!*.example.env
secrets/
credentials/
*.key
*.pem
.streamlit/secrets.toml

# Versioned teach/replay examples. Keep ad-hoc generated files local unless
# they are curated JSON recordings under recordings/teach/.
recordings/*
!recordings/teach/
!recordings/teach/*.json

# Local planning notes are not part of the public repository.
plan.md
PLAN.md

# Third-party policy:
# - keep the small runtime/source subset needed for normal build and demos;
# - keep bulky vendor manuals, videos, installers, archives, and full upstream
#   asset packs local unless explicitly fetched by scripts.
third_party/*
src/vendor/*
!src/vendor/aubo_description
!src/vendor/dh_ag95_description
!src/vendor/scout_description

# Never commit nested upstream repository metadata or generated bytecode.
third_party/**/.git/
third_party/**/__pycache__/
third_party/**/*.pyc

# Small source/runtime subsets vendored for reproducibility.
!third_party/aubo_description/
third_party/aubo_description/*
!third_party/aubo_description/.gitkeep
!third_party/aubo_description/CHANGELOG.md
!third_party/aubo_description/CMakeLists.txt
!third_party/aubo_description/README.md
!third_party/aubo_description/package.xml
!third_party/aubo_description/ros1_xacro.sh
!third_party/aubo_description/xacro.sh
!third_party/aubo_description/launch/
!third_party/aubo_description/launch/**
!third_party/aubo_description/rviz/
!third_party/aubo_description/rviz/**
!third_party/aubo_description/scripts/
!third_party/aubo_description/scripts/calibrate_urdf_dh.py
!third_party/aubo_description/meshes/
third_party/aubo_description/meshes/*
!third_party/aubo_description/meshes/aubo_i5*/
third_party/aubo_description/meshes/aubo_i5*/**
!third_party/aubo_description/meshes/aubo_i5*/visual/
!third_party/aubo_description/meshes/aubo_i5*/visual/*.DAE
!third_party/aubo_description/meshes/aubo_i5*/collision/
!third_party/aubo_description/meshes/aubo_i5*/collision/*.STL
third_party/aubo_description/meshes/aubo_i5*/**/*.3ds
third_party/aubo_description/meshes/aubo_i5*/**/*.import
third_party/aubo_description/meshes/aubo_i5/visual/visual
third_party/aubo_description/meshes/aubo_i5/visual/link0.3ds
third_party/aubo_description/meshes/aubo_i5H/
third_party/aubo_description/meshes/aubo_i5H_B0/
third_party/aubo_description/meshes/aubo_i5H_B0_white/
third_party/aubo_description/meshes/aubo_i5-NET/collision
!third_party/aubo_description/urdf/
!third_party/aubo_description/urdf/**

!third_party/scout_ros2/
!third_party/scout_ros2/**
third_party/scout_ros2/.git/

!third_party/ugv_sdk/
!third_party/ugv_sdk/**
third_party/ugv_sdk/.git/

!third_party/aubo_ros2_driver/
!third_party/aubo_ros2_driver/**
third_party/aubo_ros2_driver/.git/
third_party/aubo_ros2_driver/**/__pycache__/
third_party/aubo_ros2_driver/**/*.pyc

!third_party/dh_ag95_gripper_ros2/
!third_party/dh_ag95_gripper_ros2/**
third_party/dh_ag95_gripper_ros2/.git/

!third_party/ms42dc_step_motor_ros2/
!third_party/ms42dc_step_motor_ros2/**

# Optional local download targets: keep their names only.
!third_party/LARA_AUBOi5_AG95/
third_party/LARA_AUBOi5_AG95/**
!third_party/LARA_AUBOi5_AG95/.gitkeep
!third_party/kenney/
third_party/kenney/**
!third_party/kenney/.gitkeep
!third_party/scout_ros/
third_party/scout_ros/**
!third_party/scout_ros/.gitkeep

# Keep the small source assets needed to reproduce the active MS42DC model.
!third_party/README.md
!third_party/MS42DC.step
!third_party/MS42DC_SPLIT/
!third_party/MS42DC_SPLIT/*.stl

tmp/
temp/
cache/

# Local agent/tooling scratch and debug leftovers (stay local, not in the repo).
.VSCodeCounter/
.pi/
.reasonix/
reasonix.toml
Log/
persist_test_ws.txt
*.bak

# Ad-hoc teach recordings: keep only curated JSON; duplicates and probe files
# (name *copy*.json, *_test.json, step1.json) stay local.
recordings/teach/*copy*.json
recordings/teach/*_test.json
recordings/teach/step1.json

# Local YOLO/TensorRT artifacts can be large and machine-specific.
yolo_workspace/runs/
yolo_workspace/cache/
yolo_workspace/temp/
yolo_workspace/tmp/
yolo_workspace/**/*.cache
yolo_workspace/**/*.engine
